# Backend configuration
DEBUG=false
LOG_LEVEL=info

# Frontend development URL (for CORS)
FRONTEND_URL=http://localhost:5173

# Instagram Provider Selection
# Options: "meta", "browser", "auto"
# "meta" = use Meta Graph API (requires credentials)
# "browser" = use Playwright scraping
# "auto" = prefer Meta if credentials exist, else Browser
INSTAGRAM_PROVIDER=auto

# Meta Graph API Configuration
# Leave blank to use Browser provider
META_GRAPH_API_VERSION=v26.0
META_IG_USER_ID=
META_ACCESS_TOKEN=
META_PAGE_SIZE=50
META_MAX_PAGES=100

# Browser Provider Configuration
BROWSER_HEADLESS=true
